<form class="{{cssClass}} scifi-urpg-ship-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="96" width="96">
    <div class="ship-header-fields">
      <div class="ship-title-row">
        <input class="ship-name" name="name" type="text" value="{{actor.name}}" placeholder="Ship name">
        <label><span>Mark</span><select name="system.mark"><option value="I" {{#if (eq system.mark "I")}}selected{{/if}}>I</option><option value="II" {{#if (eq system.mark "II")}}selected{{/if}}>II</option><option value="III" {{#if (eq system.mark "III")}}selected{{/if}}>III</option><option value="IV" {{#if (eq system.mark "IV")}}selected{{/if}}>IV</option><option value="V" {{#if (eq system.mark "V")}}selected{{/if}}>V</option></select></label>
      </div>
      <div class="ship-status-grid">
        <label><span>Battery</span><input name="system.energy.value" type="number" min="0" max="{{system.energy.max}}" value="{{system.energy.value}}"> / {{system.energy.max}} kWs</label>
        <label><span>Hull</span><input name="system.hull.value" type="number" min="0" max="{{system.hull.max}}" value="{{system.hull.value}}"> / {{system.hull.max}}</label>
        <label><span>Shields</span><input name="system.shields.value" type="number" min="0" max="{{system.shields.max}}" value="{{system.shields.value}}"> / {{system.shields.max}}</label>
      </div>
      <div class="ship-attack-row">
        <div class="equipped-weapon-display"><span>Weapon</span><strong>{{attack.weaponName}}</strong></div>
        <label><span>Modifier</span><input type="number" data-field="attack-bonus" value="{{attack.bonusInput}}" step="1" placeholder="-"></label>
        <div class="ship-header-attack-control"><span class="ship-header-attack-label">&nbsp;</span><div class="ship-header-attack-row"><button type="button" class="attack-button ship-skill-roll" data-action="attack-target" {{#unless attack.hasWeapon}}disabled{{/unless}}>Attack</button></div></div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="overview">Overview</a>
    <a class="item" data-tab="weapons">Weapons</a>
    <a class="item" data-tab="crew">Crew</a>
    <a class="item" data-tab="movement">Movement</a>
    <a class="item" data-tab="notes">Notes</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="overview">
      <div class="ship-stat-grid">
        <label><span>Mass (t)</span><input name="system.mass" type="number" min="0" step="0.1" value="{{system.mass}}"></label>
        <label><span>Hull maximum</span><input name="system.hull.max" type="number" min="1" value="{{system.hull.max}}"></label>
        <label><span>Shield maximum</span><input name="system.shields.max" type="number" min="0" value="{{system.shields.max}}"></label>
        <label><span>Battery maximum (kWs)</span><input name="system.energy.max" type="number" min="0" value="{{system.energy.max}}"></label>
        <label><span>Reactor (kW)</span><input name="system.reactor.output" type="number" min="0" value="{{system.reactor.output}}"></label>
        <label><span>Dilithium (t)</span><input name="system.dilithium" type="number" min="0" step="0.001" value="{{system.dilithium}}"></label>
      </div>
      <button type="button" data-action="recharge-shields">Recharge shields from battery</button>
      <button type="button" data-action="generate-reactor-energy">Generate one round of reactor energy</button>
      <label><span>Convert Dilithium (t)</span><input data-field="dilithium-conversion" type="number" min="0" step="0.000001" value="{{dilithiumConversion}}"></label>
      <button type="button" data-action="convert-dilithium">Convert Dilithium to battery energy</button>
      <p class="ship-rule-note">Shields cover every direction. Damage drains shield charge first; shields and weapons do not take conventional Loss.</p>
    </div>

    <div class="tab" data-group="primary" data-tab="weapons">
      <div class="ship-toolbar"><span>Every weapon fires independently and may target any direction.</span><button type="button" data-action="add-weapon">Add weapon</button></div>
      {{#each weapons}}
        <article class="ship-weapon-row{{#if selected}} selected{{/if}}">
          <button type="button" class="ship-weapon-select" data-action="select-weapon" data-item-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><span>Damage {{damage}} · Accuracy {{accuracy}} · Range {{rangeModifier}}</span></span></button>
          <div class="ship-weapon-actions"><button type="button" data-action="edit-weapon" data-item-id="{{id}}">Edit</button><button type="button" data-action="delete-weapon" data-item-id="{{id}}">Delete</button></div>
        </article>
      {{else}}<p>No ship weapons. Add one here or drag a Ship Weapon item onto this ship.</p>{{/each}}
      <p class="ship-rule-note">At 1 km the range modifier is 0; each doubling of distance is −6.</p>
    </div>

    <div class="tab" data-group="primary" data-tab="crew">
      <div class="ship-toolbar"><span>Drag Actors here to assign them as gunners.</span></div>
      {{#each gunners}}<article class="ship-crew-row"><img src="{{img}}" alt=""><strong>{{name}}</strong><button type="button" data-action="delete-gunner" data-actor-id="{{id}}">Delete</button></article>{{/each}}
    </div>

    <div class="tab" data-group="primary" data-tab="movement">
      <div class="ship-stat-grid"><label><span>Velocity X</span><input name="system.movement.velocityX" type="number" value="{{system.movement.velocityX}}"></label><label><span>Velocity Y</span><input name="system.movement.velocityY" type="number" value="{{system.movement.velocityY}}"></label><div><span>Speed</span><strong>{{speed}}</strong></div></div>
      <div class="ship-stat-grid"><label><span>Acceleration X</span><input data-field="acceleration-x" type="number" value="{{acceleration.x}}"></label><label><span>Acceleration Y</span><input data-field="acceleration-y" type="number" value="{{acceleration.y}}"></label><button type="button" data-action="apply-acceleration">Accelerate / brake</button></div>
      <p class="ship-rule-note">Dragging a token is free bookkeeping. Only a change in velocity costs energy: (|ΔX| + |ΔY|) × mass. Rotation and firing direction are unrestricted.</p>
    </div>

    <div class="tab" data-group="primary" data-tab="notes">
      <label class="ship-notes"><span>Notes</span><textarea name="system.notes">{{system.notes}}</textarea></label>
    </div>
  </section>
</form>
